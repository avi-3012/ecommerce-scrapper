# PricePulse FLIPKART worker (home machine). Copy to deploy/.env.worker and fill.
# See docs/FLIPKART-WORKER.md for the whole procedure.

# The AWS Postgres, reached through the SSH tunnel on this machine's loopback.
# Start the tunnel first:
#   ssh -N -L 15432:127.0.0.1:5432 -i pricepulse.pem ubuntu@<ELASTIC_IP>
DATABASE_URL=postgresql://pricepulse:CHANGE_ME_same_as_aws@host.docker.internal:15432/pricepulse

NODE_ENV=production
# MUST be byte-identical to SETTINGS_ENC_KEY in deploy/.env.aws. The worker
# refuses to start without it, even though this secondary worker never uses
# Telegram itself.
SETTINGS_ENC_KEY=CHANGE_ME_same_64_hex_chars_as_aws

WORKER_HEARTBEAT_SECONDS=30
SCHEDULER_TICK_SECONDS=20

# Where the identity pool lives inside the container (a named volume).
IDENTITY_DIR=/repo/data/identities

# Scope, role and status row are set in deploy/docker-compose.worker.yml:
#   WORKER_MARKETPLACES=flipkart  WORKER_ROLE=secondary  WORKER_STATUS_ID=2
#   SCRAPING_CONFIG=/repo/config/scraping.flipkart.json

# Kill switch: set to 1 to stop all fetching within 5 seconds.
# PAUSE=1
