# PricePulse on AWS (dashboard + database). Copy to deploy/.env.aws ON THE EC2
# INSTANCE and fill in. Never commit the real file.

# ── Database (compose creates this Postgres) ──
POSTGRES_USER=pricepulse
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=pricepulse
# Host is the compose service name "db" — this is the API's view of it.
DATABASE_URL=postgresql://pricepulse:CHANGE_ME_long_random_password@db:5432/pricepulse

# ── Public hostname ──
# Defaults to plain HTTP on the instance's IP, so a fresh deploy is reachable
# without a domain. Caddy serves :80 for any Host and requests no certificate.
#
# The value below is NOT a placeholder to edit later — leaving a made-up domain
# here is worse than useless: Caddy would 308-redirect every request to HTTPS
# and then fail forever to get a certificate (Let's Encrypt refuses example.com
# by policy), so the site is simply unreachable with no obvious cause.
SITE_HOSTNAME=:80

# Once you have a real domain with an A record pointing at this instance,
# switch to it and set COOKIE_SECURE=true. Caddy obtains the certificate itself.
#   SITE_HOSTNAME=pricepulse.yourdomain.com

NODE_ENV=production
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# EXACTLY 64 hex chars. MUST be identical here and in the worker's env, or the
# worker cannot decrypt the Telegram token the API encrypted.
SETTINGS_ENC_KEY=CHANGE_ME_64_hex_chars

# MUST be false while serving plain HTTP: the session cookie is marked Secure
# otherwise, browsers drop it, and login appears to succeed then bounces you
# straight back to the login page. Set true the moment you move to HTTPS.
COOKIE_SECURE=false

# ── Scraping ──
# Where identities, cookie jars, IP backoff state and captured failure bodies
# are persisted. Backed by a docker volume; must not be ephemeral.
IDENTITY_DIR=/repo/data/identities
# The full-AWS profile: large identity pool, 1-minute cadence, tiering and
# diurnal pacing off. See the header of that file for the trade-offs.
SCRAPING_CONFIG=/repo/config/scraping.aws.json

WORKER_HEARTBEAT_SECONDS=30
SCHEDULER_TICK_SECONDS=20

# Kill switch: set to 1 to stop all fetching within 5 seconds.
# PAUSE=1

# ── Login account (seeded on first deploy) ──
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=CHANGE_ME_strong_password
