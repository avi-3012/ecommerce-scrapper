# dependencies
node_modules/

# builds
dist/
*.tsbuildinfo

# environment / secrets — never commit real values
.env
.env.*
!.env.example
!*.example

# SSH / cloud private keys — NEVER commit
*.pem
*.key
*.p12
*.pfx

# logs & OS noise
*.log
.DS_Store

# test artifacts
coverage/

# CSV/XLSX exports pulled from the running app — runtime data, not source.
# These are multi-megabyte audit dumps; they belong in a download folder.
pricepulse-*.csv

# identity pool: cookie jars, per-identity browser profiles, captured block
# bodies, IP backoff state. Runtime state, never committed — and the jars in
# particular are session material.
data/

# prisma generated client lives in node_modules; nothing extra to ignore
